            ],
            "title": "Platform",
            "type": "string"
          },
          "account": {
            "description": "Username (Instagram/TikTok), channel handle or ID (YouTube), or a full profile URL",
            "title": "Account",
            "type": "string"
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "next_cursor from the previous call, to get the next page",
            "title": "Cursor"
          }
        },
        "required": [
          "platform",
          "account"
        ],
        "title": "get_creator_postsArguments",
        "type": "object"
      }
    },
    {
      "name": "get_post",
      "description": "One post's stats and content (0.02 credits).",
