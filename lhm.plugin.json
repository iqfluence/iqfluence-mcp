            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "platform"
        ],
        "title": "list_my_reportsArguments",
        "type": "object"
      }
    },
    {
      "name": "list_campaigns",
      "description": "Campaign Monitoring campaigns (free).",
      "inputSchema": {
        "properties": {
          "status": {
            "anyOf": [
              {
                "enum": [
                  "draft",
                  "active",
                  "archive"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only campaigns in this status",
            "title": "Status"
          }
        },
        "title": "list_campaignsArguments",
        "type": "object"
      }
    }
  ]
}
